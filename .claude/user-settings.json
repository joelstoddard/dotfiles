{
  "autoCompactEnabled": false,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "building@guardrails": true,
    "frontend-design@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "personas@guardrails": true,
    "recording@guardrails": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "EDITOR": "nvim"
  },
  "extraKnownMarketplaces": {
    "guardrails": {
      "autoUpdate": true,
      "source": {
        "repo": "joelstoddard/guardrails",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state blocked",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state asking",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state working",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state working",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state off",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state idle",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state stop",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state done",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -z \"$TMUX_PANE\" ] || claude-tmux-state working",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(git stash list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(brew list:*)",
      "Bash(.venv/bin/pip install:*)",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_project",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_milestones",
      "mcp__linear-server__get_milestone",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_cycles",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_read_channel",
      "mcp__plugin_slack_slack__slack_search_public",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "Skill(building:commit)",
      "Skill(update-config)",
      "WebSearch",
      "WebFetch(domain:docs.blacksmith.sh)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.conventionalcommits.org)",
      "Read(~/**)",
      "Bash(git push:*)",
      "Bash(gh pr create --draft:*)"
    ],
    "ask": [
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run rerun:*)",
      "mcp__linear-server__save_issue",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__save_project",
      "mcp__claude_ai_Linear__save_document",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "Artifact",
      "Bash(gh issue create:*)",
      "Bash(terraform apply:*)",
      "Bash(tofu apply:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(pulumi up:*)",
      "Bash(git tag:*)",
      "Bash(terraform * apply)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy:*)",
      "Bash(terraform * destroy)",
      "Bash(terraform * destroy *)",
      "Bash(tofu * apply)",
      "Bash(tofu * apply *)",
      "Bash(tofu destroy:*)",
      "Bash(tofu * destroy)",
      "Bash(tofu * destroy *)",
      "Bash(pulumi * up)",
      "Bash(pulumi * up *)",
      "Bash(pulumi destroy:*)",
      "Bash(pulumi * destroy)",
      "Bash(pulumi * destroy *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl * delete *)",
      "Bash(helm * install *)",
      "Bash(helm * upgrade *)",
      "Bash(helm * uninstall *)",
      "Bash(helm rollback:*)",
      "Bash(helm * rollback *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh release:*)",
      "Bash(gh gist:*)",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__plugin_slack_slack__slack_create_conversation",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__linear-server__save_comment",
      "mcp__linear-server__delete_comment",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__delete_comment",
      "mcp__claude_ai_Linear__save_diff_comment",
      "mcp__claude_ai_Linear__delete_diff_comment",
      "mcp__claude_ai_Linear__submit_diff_review",
      "mcp__claude_ai_Linear__resolve_diff_thread",
      "mcp__claude_ai_Linear__save_status_update",
      "mcp__claude_ai_Linear__share_issue",
      "mcp__claude_ai_Linear__merge_diff",
      "mcp__claude_ai_Notion__notion-create-comment",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "oh-my-posh claude --config ~/.config/oh-my-posh/claude.yaml",
    "type": "command"
  },
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
